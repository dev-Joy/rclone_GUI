{
    "compilerOptions": {
        "composite": true,
        "target": "ES2023",
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "paths": { "@/*": ["src/*"] }
    },
    "include": [
        "src/main/**/*",
        "src/preload/**/*",
        "src/shared/**/*",
        "src/lib/compare-view.ts",
        "src/lib/form-utils.ts",
        "src/lib/job-form.ts",
        "src/lib/path-display.ts",
        "src/lib/run-view.ts",
        "src/lib/settings-form.ts",
        "src/lib/virtual-rows.ts",
        "tests/**/*",
        "electron.vite.config.mts",
        "vitest.config.mts",
        "vitest.integration.config.mts"
    ],
    "exclude": ["tests/unit/renderer/**"]
}
