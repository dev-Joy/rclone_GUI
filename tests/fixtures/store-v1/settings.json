{
  "version": 1,
  "rclonePath": null,
  "configPath": "C:\\tmp\\rclone.conf",
  "defaults": {
    "excludes": [
      "node_modules/**",
      "*.tmp"
    ],
    "checkers": 8,
    "transfers": 4,
    "fastList": true,
    "skipLinks": true,
    "ignoreErrors": false,
    "checkHashes": false,
    "modtimeToleranceMs": 2000,
    "preflightBeforeDestructive": true
  },
  "compare": {
    "caseInsensitivePaths": true
  },
  "safety": {
    "deleteConfirmFiles": 50,
    "deleteConfirmPercent": 10,
    "autoMaxDeletes": 50,
    "compareMaxAgeMinutes": 10
  },
  "scheduler": {
    "paused": true
  },
  "logs": {
    "retentionDays": 30,
    "historyLimit": 200
  },
  "ui": {
    "theme": "dark",
    "minimizeToTray": true,
    "launchAtLogin": false
  }
}
