{
    "name": "rclonegui",
    "productName": "rcloneGUI",
    "version": "0.1.0",
    "private": true,
    "description": "rclone 기반 Windows 폴더 비교·동기화 데스크톱 앱",
    "author": "dev-Joy",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "start": "electron-vite preview",
        "build:win": "pnpm run build && electron-builder --win nsis --x64 --publish never",
        "dist": "pnpm run build:win",
        "smoke:installer": "node scripts/dev/installer-smoke.mjs",
        "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
        "lint": "oxlint --deny-warnings && eslint --max-warnings=0 .",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:int": "vitest run --config vitest.integration.config.mts",
        "test:e2e": "pnpm run build && playwright test",
        "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
        "postinstall": "node node_modules/electron/install.js"
    },
    "dependencies": {
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "electron": "45.0.0",
        "electron-builder": "26.18.0",
        "electron-vite": "6.0.0",
        "eslint": "10.13.0",
        "oxfmt": "0.75.0",
        "oxlint": "1.90.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.72.1",
        "vite": "8.3.5",
        "vitest": "5.0.5",
        "zustand": "5.0.16"
    }
}
