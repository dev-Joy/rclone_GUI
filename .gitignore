# Dependencies
node_modules/

# Build output (electron-vite → out/, electron-builder → release/)
# build/ 는 electron-builder 리소스(icon.ico 등) 폴더이므로 제외하지 않는다.
out/
release/
dist/
*.tsbuildinfo

# Test output
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / secrets (rclone.conf에는 OAuth 토큰이 포함될 수 있음)
.env
.env.*
!.env.example
rclone.conf
*.conf.bak

# Caches
.cache/
.eslintcache
.vite/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~

# Local Claude Code settings
.claude/settings.local.json
