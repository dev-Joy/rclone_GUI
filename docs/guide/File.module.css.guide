/**
 *  Page/Layout Stylesheet Guide (CSS Module)
 *
 *  @author dev-Joy    YYYY-MM-DD  **<- 필수**
 *  @description
 *      - 페이지/레이아웃 컴포넌트의 스타일 파일 규격
 *      - 실제 사용 예시: src/pages/JobPage.module.css (pages 레이어),
 *                        src/pages/AppLayout.module.css (layouts 레이어)
 *      - CSS Cascade Layers 구조: base < components < layouts < pages
 */

/* ------------------------------------------------------------------
 *  1. 파일 위치 & 명칭
 * ------------------------------------------------------------------
 *  - 위치: 컴포넌트(.tsx)와 같은 폴더에 생성
 *      - 페이지:  src/pages/JobPage.module.css
 *      - 레이아웃: src/pages/AppLayout.module.css
 *        (rcloneGUI 은 페이지와 레이아웃을 모두 src/pages 에 둔다)
 *  - 명칭: 반드시 `컴포넌트명.module.css` (CSS Modules 자동 인식)
 *  - import (TSX에서): 동일 폴더이므로 "./" 사용
 *      import styles from "./JobPage.module.css";
 * ------------------------------------------------------------------ */

/* ------------------------------------------------------------------
 *  2. CSS Cascade Layers 배정 (필수)
 * ------------------------------------------------------------------
 *  - 페이지 module.css  -> @layer pages  { ... }
 *  - 레이아웃 module.css -> @layer layouts { ... }
 *  - 레이어에 배정하면 components 레이어의 공용 스타일을
 *    명시도와 무관하게 구조적으로 오버라이드할 수 있음
 *  - 레이어 선언 순서: base < components < layouts < pages
 *    (선언 위치는 src/components/ZBC.css 최상단, 파일 내부에서는 배정만 함)
 *  - ZBC.css 는 화면 진입점 src/renderer/main.tsx 에서 한 번만 import 한다
 * ------------------------------------------------------------------ */

/* ------------------------------------------------------------------
 *  3. 클래스 명명 규칙
 * ------------------------------------------------------------------
 *  - 최상단 클래스: 컴포넌트명과 동일하게 생성 (예: .JobPage, .AppLayout)
 *  - 내부 dom 클래스: prefix 없이 목적 중심으로 사용 (예: .title, .content, .footer)
 *  - 들여쓰기: 공백 4칸 (탭 사용 금지)
 *  - 컬러: 하드코딩 금지, 전역 테마 변수 var(--zbc-*) 참조
 *    (변수 정의: src/components/themes/default.css — --zbc-bg, --zbc-surface,
 *     --zbc-text, --zbc-muted, --zbc-accent, --zbc-add, --zbc-change, --zbc-delete …)
 * ------------------------------------------------------------------ */

/* ------------------------------------------------------------------
 *  4. 공용 컴포넌트 오버라이드 (선택)
 * ------------------------------------------------------------------
 *  - 공용 클래스(.zbcXxx)를 직접 수정해야 할 때는 :global() 사용
 *  - :global()로 감싼 선택자만 전역 클래스로 유지되고, 나머지 로컬
 *    클래스는 CSS Modules에 의해 해시 처리됨
 *  - 공용 셀렉터 예: .zbc.zbcField .zbcFieldLabel (명시도 0,3,0)
 *    -> pages 레이어 안의 오버라이드는 명시도와 무관하게 항상 우선
 * ------------------------------------------------------------------ */

/* ------------------------------------------------------------------
 *  5. Electron 에서 달라지는 점
 * ------------------------------------------------------------------
 *  - 화면은 Electron 에 내장된 Chromium 한 종류에서만 돈다. CSS 중첩(nesting),
 *    @layer, :has() 등을 폴리필 없이 쓴다. 브라우저 접두사(-webkit- 등)는 붙이지 않는다
 *  - CSP(src/renderer/index.html): 외부 주소의 폰트 · 이미지 · 스타일을 불러오지 않는다.
 *    폰트는 시스템 글꼴(var(--zbc-font), var(--zbc-font-mono))을 쓴다
 *  - 어두운 테마는 prefers-color-scheme 로 테마 변수만 바꾼다. 페이지 CSS 에서
 *    밝은/어두운 색을 따로 쓰지 않는다
 *  - 창 크기가 바뀌므로 고정 폭 대신 flex / grid 와 min-width: 0 으로 줄임표 처리한다
 * ------------------------------------------------------------------ */

@layer pages {
    /* 최상단 클래스 - 컴포넌트명과 동일 */
    .JobPage {
        /* 내부 dom - prefix 없이 사용 */
        .title {
            font-size: 1.1rem;
            color: var(--zbc-text);
        }

        /* 공용 컴포넌트 오버라이드 - :global()로 전역 클래스 타깃 */
        .actions :global(.zbcButton) {
            min-width: 4rem;
        }
    }
}

/* 실제 적용 예시 (src/pages/JobListPane.module.css 발췌) */
/*
 *  @author dev-Joy 2026-10-11
 *  @description
 *      - JobListPane(왼쪽 작업 목록) 스타일
 *      - pages 레이어에 배정되어 components 레이어의 공용 스타일을 특이도 무관하게 오버라이드
 *
 *  @layer pages {
 *      .JobListPane {
 *          .item :global(.zbcDot) {
 *              margin-top: 6px;
 *          }
 *      }
 *  }
 */
